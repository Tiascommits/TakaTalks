# Postgres connection string used by the app (dev, and by Vercel in prod).
# A free Neon project (https://neon.tech) works well — Vercel's Neon
# integration can also provision and set this automatically.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Separate, disposable Postgres database used only by `npm run test:e2e`.
# It gets wiped (`prisma migrate reset`) on every test run — never point
# this at your dev or prod database. A second free Neon branch/database
# works well for this.
TEST_DATABASE_URL="postgresql://user:password@host/dbname_test?sslmode=require"
