generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Created lazily, only when the person first saves something (an income
// entry, an investment, or a tax profile setting) — never at page load.
// See docs/feature-spec-tax-calculator.md: account creation is deferred to
// the moment persistence is actually needed.
model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Both optional and both nullable independently — set only once the user
  // opts in at the one point an account is allowed to appear (setting a
  // maturity reminder, see docs/feature-spec-tax-calculator.md). Verified
  // timestamps double as "is this channel actually usable," since an
  // unverified destination must never receive a real reminder.
  email           String?   @unique
  emailVerifiedAt DateTime?
  phone           String?   @unique
  phoneVerifiedAt DateTime?

  incomeEntries      IncomeEntry[]
  investmentEntries  InvestmentEntry[]
  taxProfile         TaxProfile?
  verificationTokens VerificationToken[]
}

enum VerificationChannel {
  EMAIL
  PHONE
}

// One row per magic-link/OTP request. Consumed (verifiedAt set) tokens are
// never reused, and expired ones are just left to rot rather than cleaned up
// eagerly, since the volume here is inherently tiny (one per login attempt).
model VerificationToken {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel     VerificationChannel
  destination String // the email or phone number this token was sent to
  token       String              @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime            @default(now())

  @@index([userId])
}

enum IncomeFrequency {
  MONTHLY
  ANNUAL
  ONE_TIME
}

model IncomeEntry {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  source    String // salary | freelance | business | rental | other
  amount    Float
  frequency IncomeFrequency
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([userId])
}

enum InstrumentType {
  SANCHAYPATRA
  GOVT_BOND
  MUTUAL_FUND
  DSE_STOCK
  LIFE_INSURANCE
  PROVIDENT_FUND
  DPS
  DONATION
  FIXED_DEPOSIT
  OTHER
}

model InvestmentEntry {
  id                String         @id @default(cuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  label             String
  instrumentType    InstrumentType
  principalAmount   Float
  startDate         DateTime
  termMonths        Int
  expectedRatePct   Float
  maturityDate      DateTime

  // Set once the user confirms the payout after maturity. Null until then.
  payoutConfirmed   Boolean        @default(false)
  payoutAmount      Float?
  payoutConfirmedAt DateTime?

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  reminderLogs      ReminderLog[]

  @@index([userId])
  @@index([maturityDate])
}

// One row per (investment, reminder window, channel) actually sent, so the
// daily cron never double-sends a reminder it already delivered for that
// window even if it runs more than once on the same day.
model ReminderLog {
  id                String              @id @default(cuid())
  investmentEntryId String
  investmentEntry   InvestmentEntry     @relation(fields: [investmentEntryId], references: [id], onDelete: Cascade)
  windowDays        Int // e.g. 7 or 1, days-before-maturity this reminder was for
  channel           VerificationChannel
  sentAt            DateTime            @default(now())

  @@unique([investmentEntryId, windowDays, channel])
}

enum TaxpayerCategory {
  GENERAL
  WOMAN_SENIOR
  THIRD_GENDER
  DISABLED
  FREEDOM_FIGHTER
}

model TaxProfile {
  id                String           @id @default(cuid())
  userId            String           @unique
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category          TaxpayerCategory @default(GENERAL)
  disabledChildren  Int              @default(0)
  firstTimeFiler    Boolean          @default(false)

  netWealth         Float            @default(0)
  multiCar          Boolean          @default(false)
  bigHouse          Boolean          @default(false)

  updatedAt         DateTime         @updatedAt
}

// --- Module 3/4: bank rate monitoring + comparison scorecard (Prompt 2) ---
// See prompts/02-rate-monitoring-and-scorecard.md. Deliberately NOT a
// recommendation engine: no computed "best bank" field anywhere here, just
// sourced, dated figures.

enum BankType {
  STATE_OWNED
  PRIVATE
  FOREIGN
  ISLAMIC
}

enum RateInstrument {
  FDR
  DPS
  SANCHAYAPATRA
}

// MANUAL = entered/seeded by a human (or a manual-seed adapter standing in
// until a real scraper exists for that bank), SCRAPED = pulled by an
// automated adapter. Kept as a first-class flag rather than parsed out of a
// text field, since the UI must never present a manual figure as if it were
// a live, automated read.
enum RateSourceMethod {
  MANUAL
  SCRAPED
}

model Bank {
  id           String    @id @default(cuid())
  name         String
  shortCode    String    @unique
  type         BankType
  websiteUrl   String?
  rateCardUrl  String?
  creditRating String?
  ratingAgency String?
  ratingDate   DateTime?
  statementUrl String?
  active       Boolean   @default(true)

  // Module 5 (bank-health disclosure): manually-supplied, never guessed from
  // a URL pattern, since every bank's investor-relations page is structured
  // differently. Null until someone verifies and enters it. See
  // prompts/03-annual-report-extraction.md and todo/needs-us-both/bank-annual-report-urls.md.
  annualReportPageUrl String?
  dseCompanyUrl       String?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  rateSnapshots         RateSnapshot[]
  scrapeLogs            ScrapeLog[]
  annualReportCheckLogs AnnualReportCheckLog[]
  extractedFigures      ExtractedFigure[]
}

// Append-only history: every successful scrape/manual-entry writes a new
// row rather than overwriting, so "current rate" is "latest row" and old
// values stay around for the admin digest's before/after comparison.
model RateSnapshot {
  id         String            @id @default(cuid())
  bankId     String
  bank       Bank              @relation(fields: [bankId], references: [id], onDelete: Cascade)
  instrument RateInstrument
  termMonths Int
  ratePct    Float
  method     RateSourceMethod
  source     String // URL for a real scrape, or a plain-text note for a manual entry
  scrapedAt  DateTime          @default(now())

  @@index([bankId, instrument, termMonths, scrapedAt])
}

// One row per scrape attempt per bank, success or failure, so a broken
// adapter is visible in the admin digest rather than just silently missing.
model ScrapeLog {
  id           String   @id @default(cuid())
  bankId       String
  bank         Bank     @relation(fields: [bankId], references: [id], onDelete: Cascade)
  attemptedAt  DateTime @default(now())
  success      Boolean
  errorMessage String?
  ratesFound   Int      @default(0)

  @@index([bankId, attemptedAt])
}

// Bangladesh Bank's published weighted-average deposit rate, entered
// manually for now (module 3's "secondary, lower-frequency cross-check").
// Always labeled in the UI as an official aggregate, never as a specific
// product rate.
model BBAggregateRate {
  id          String   @id @default(cuid())
  label       String
  ratePct     Float
  periodLabel String
  source      String
  enteredAt   DateTime @default(now())
}

// --- Module 5: annual audited report extraction pipeline (Prompt 3) ---
// See prompts/03-annual-report-extraction.md. Runs on a monthly cadence,
// completely separate from module 3's daily rate scraper. Nothing extracted
// here reaches the public scorecard without a human approving it first.

// One row per monthly check per bank, so a bank whose page never yields a
// new PDF (or errors every time) is visible in the admin view rather than
// just silently having no data.
model AnnualReportCheckLog {
  id           String   @id @default(cuid())
  bankId       String
  bank         Bank     @relation(fields: [bankId], references: [id], onDelete: Cascade)
  checkedAt    DateTime @default(now())
  foundNewDoc  Boolean  @default(false)
  docUrl       String?
  errorMessage String?

  @@index([bankId, checkedAt])
}

enum AnnualReportField {
  CAR // Capital to Risk-Weighted Assets Ratio (CRAR)
  NPL
  ROA
  ROE
  TOTAL_DEPOSITS
  TOTAL_LOANS
  NET_PROFIT
  AUDITOR_NAME
  AUDIT_REPORT_DATE
}

// {bankId, fiscalYear, field} extracted from a PDF, kept unapproved until an
// admin checks it against the source document — layout varies enough bank to
// bank that first-pass extraction isn't trusted on its own. See
// src/lib/bank-health/extract-figures.ts.
model ExtractedFigure {
  id                   String            @id @default(cuid())
  bankId               String
  bank                 Bank              @relation(fields: [bankId], references: [id], onDelete: Cascade)
  fiscalYear           Int
  field                AnnualReportField
  rawValue             String // the exact text matched, kept for audit even after numericValue is parsed
  numericValue         Float?
  extractionConfidence Float // 0-1, heuristic based on match specificity
  sourceReportUrl      String
  sourcePageOrNote     String?
  extractedAt          DateTime          @default(now())

  approved         Boolean   @default(false)
  approvedAt       DateTime?
  approvedByAdmin  AdminUser? @relation(fields: [approvedByAdminId], references: [id])
  approvedByAdminId String?

  @@index([bankId, fiscalYear, field])
  @@index([approved])
}

// --- Admin accounts + audit log ---
// Replaces the single shared ADMIN_SECRET cookie (src/lib/admin/auth.ts) so
// more than one person can administer the app with a visible trail of who
// changed what. ADMIN_SECRET becomes a one-time bootstrap to create the
// first AdminUser (see /admin/setup) rather than the ongoing auth mechanism.
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  sessions         AdminSession[]
  auditLogs        AdminAuditLog[]
  approvedFigures  ExtractedFigure[]
}

model AdminSession {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime

  @@index([adminUserId])
}

// Written on every admin action worth attributing: bank field edits,
// ExtractedFigure approve/reject, manual rate/BB-aggregate entry, scrape
// trigger. `detail` is a free-form snapshot of what changed, not a strict
// schema, since the set of admin actions will keep growing.
model AdminAuditLog {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  action      String
  targetType  String
  targetId    String
  detail      Json?
  createdAt   DateTime  @default(now())

  @@index([adminUserId, createdAt])
  @@index([targetType, targetId])
}
