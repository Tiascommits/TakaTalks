# Postgres connection string used by the app. In prod (Vercel) use a free
# Neon project (https://neon.tech) — its Vercel integration can provision
# and set this automatically. Locally, the default below matches
# `docker-compose up -d` (see README.md) — swap in a Neon URL instead if
# you'd rather not run Postgres locally.
DATABASE_URL="postgresql://postgres:postgres@localhost:55432/takatalks"

# Separate, disposable Postgres database used only by `npm run test:e2e`.
# It gets wiped (`prisma migrate reset`) on every test run — never point
# this at your dev or prod database. The default below is a second database
# on the same local docker-compose Postgres; a second free Neon
# branch/database works well too if you're using Neon for DATABASE_URL.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:55432/takatalks_test"

# Shared secret gating the internal admin pages (/admin/rates) — triggering
# a rate scrape, entering the BB aggregate cross-check rate, editing a
# bank's credit rating / statement link. Also doubles as the one-time
# bootstrap to create the first named AdminUser account (see /admin/setup);
# after that, admin login is per-person email+password. Pick any long
# random string.
ADMIN_SECRET="change-me-to-a-long-random-string"

# Key that signs the anonymous-session cookie (taka_uid). Set a dedicated long
# random string in production. If unset it falls back to ADMIN_SECRET, and if
# neither is set the app refuses to sign sessions in production (it throws).
# Changing it signs everyone out of their anonymous tracker session.
SESSION_SECRET="change-me-to-a-different-long-random-string"

# Shared secret Vercel Cron sends as `Authorization: Bearer $CRON_SECRET`
# when calling /api/cron/*. Without this set, all cron routes refuse every
# request (no unauthenticated fallback). Pick any long random string.
CRON_SECRET="change-me-to-a-long-random-string"

# Base URL used to build links sent in emails (magic-link login). Falls back
# to the request's own origin if unset, but set it explicitly in production.
NEXT_PUBLIC_APP_URL="https://your-deployed-domain.example"

# --- Email (magic-link login, maturity reminders, admin rate-scrape digest) ---
# See todo/my-work/email-provider-setup.md. Both must be set for email to
# send; unset means the feature quietly no-ops rather than failing loudly.
RESEND_API_KEY=""
EMAIL_FROM="TakaTalks <reminders@your-verified-domain.example>"
# Where the daily rate-scrape digest is emailed, when it's non-empty.
ADMIN_EMAIL=""

# --- WhatsApp (maturity reminders, phone-number OTP login) ---
# See todo/my-work/whatsapp-business-api-setup.md. All four must be set for
# WhatsApp to send; unset means the feature quietly no-ops. Template names
# come from Meta's template-approval step, not made up locally.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_REMINDER_TEMPLATE_NAME=""
WHATSAPP_OTP_TEMPLATE_NAME=""

# YouTube API
YOUTUBE_API_KEY=""
YOUTUBE_CHANNEL_ID=""

# --- Analytics (GoatCounter, cookie-less) ---
# Your goatcounter.com site code — the `<code>` in `https://<code>.goatcounter.com`.
# A custom domain or self-hosted host works too ("stats.example.com"). Leave blank
# and analytics is off entirely: no script is loaded and nothing is sent. Keep it
# blank locally so dev traffic stays out of the production stats; set it only in
# Vercel's production environment. GoatCounter sets no cookies and records no
# personal data — see src/lib/analytics/goatcounter.ts.
NEXT_PUBLIC_GOATCOUNTER_CODE=""
